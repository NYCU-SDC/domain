{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nycu-club-local",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "vars": {
    "ENVIRONMENT": "local",
    "APP_ORIGIN": "http://localhost:5173",
    "CLOUDFLARE_ZONE_ID": "replace-with-zone-id",
    "CLOUDFLARE_ZONE_NAME": "nycu.club",
    "BOOTSTRAP_ADMIN_GITHUB_IDS": "",
    "PROTECTED_HOSTNAMES": "[\"nycu.club\",\"www.nycu.club\",\"api.nycu.club\",\"mail.nycu.club\",\"_dmarc.nycu.club\"]",
    "PROTECTED_RECORD_IDS": "[]",
    "ALLOW_PROXIED_DEEP_SUBDOMAINS": "false",
    "ENABLE_PURGE_EVERYTHING": "false",
    "SESSION_MAX_AGE_SECONDS": "604800"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nycu-club",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "DNS_MUTATION_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    { "name": "CACHE_PURGE_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } },
    { "name": "ADMIN_MUTATION_RATE_LIMITER", "namespace_id": "1005", "simple": { "limit": 30, "period": 60 } },
    { "name": "PURGE_EVERYTHING_RATE_LIMITER", "namespace_id": "1006", "simple": { "limit": 1, "period": 60 } }
  ],
  "env": {
    "staging": {
      "name": "nycu-club-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_ORIGIN": "https://staging.nycu.club",
        "CLOUDFLARE_ZONE_ID": "replace-with-staging-zone-id",
        "CLOUDFLARE_ZONE_NAME": "nycu.club",
        "BOOTSTRAP_ADMIN_GITHUB_IDS": "",
        "PROTECTED_HOSTNAMES": "[\"nycu.club\",\"www.nycu.club\",\"api.nycu.club\",\"mail.nycu.club\",\"_dmarc.nycu.club\"]",
        "PROTECTED_RECORD_IDS": "[]",
        "ALLOW_PROXIED_DEEP_SUBDOMAINS": "false",
        "ENABLE_PURGE_EVERYTHING": "false",
        "SESSION_MAX_AGE_SECONDS": "604800"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nycu-club-staging",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "drizzle"
        }
      ],
      "ratelimits": [
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "1101", "simple": { "limit": 10, "period": 60 } },
        { "name": "API_RATE_LIMITER", "namespace_id": "1102", "simple": { "limit": 120, "period": 60 } },
        { "name": "DNS_MUTATION_RATE_LIMITER", "namespace_id": "1103", "simple": { "limit": 30, "period": 60 } },
        { "name": "CACHE_PURGE_RATE_LIMITER", "namespace_id": "1104", "simple": { "limit": 5, "period": 60 } },
        { "name": "ADMIN_MUTATION_RATE_LIMITER", "namespace_id": "1105", "simple": { "limit": 30, "period": 60 } },
        { "name": "PURGE_EVERYTHING_RATE_LIMITER", "namespace_id": "1106", "simple": { "limit": 1, "period": 60 } }
      ]
    },
    "production": {
      "name": "nycu-club",
      "routes": [{ "pattern": "nycu.club", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        "APP_ORIGIN": "https://nycu.club",
        "CLOUDFLARE_ZONE_ID": "replace-with-production-zone-id",
        "CLOUDFLARE_ZONE_NAME": "nycu.club",
        "BOOTSTRAP_ADMIN_GITHUB_IDS": "",
        "PROTECTED_HOSTNAMES": "[\"nycu.club\",\"www.nycu.club\",\"api.nycu.club\",\"mail.nycu.club\",\"_dmarc.nycu.club\"]",
        "PROTECTED_RECORD_IDS": "[]",
        "ALLOW_PROXIED_DEEP_SUBDOMAINS": "false",
        "ENABLE_PURGE_EVERYTHING": "false",
        "SESSION_MAX_AGE_SECONDS": "604800"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nycu-club",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "drizzle"
        }
      ],
      "ratelimits": [
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "1201", "simple": { "limit": 10, "period": 60 } },
        { "name": "API_RATE_LIMITER", "namespace_id": "1202", "simple": { "limit": 120, "period": 60 } },
        { "name": "DNS_MUTATION_RATE_LIMITER", "namespace_id": "1203", "simple": { "limit": 30, "period": 60 } },
        { "name": "CACHE_PURGE_RATE_LIMITER", "namespace_id": "1204", "simple": { "limit": 5, "period": 60 } },
        { "name": "ADMIN_MUTATION_RATE_LIMITER", "namespace_id": "1205", "simple": { "limit": 30, "period": 60 } },
        { "name": "PURGE_EVERYTHING_RATE_LIMITER", "namespace_id": "1206", "simple": { "limit": 1, "period": 60 } }
      ]
    }
  }
}
