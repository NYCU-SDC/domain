{
	"name": "nycu-club-domain-console",
	"version": "1.0.0",
	"private": true,
	"description": "Secure namespace-scoped DNS and cache management for nycu.club",
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"cf:typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply nycu-club --local",
		"db:migrate:remote": "CLOUDFLARE_ENV=production wrangler d1 migrations apply nycu-club --remote",
		"db:migrate:staging": "CLOUDFLARE_ENV=staging wrangler d1 migrations apply nycu-club-staging --remote",
		"deploy": "CLOUDFLARE_ENV=production pnpm build && CLOUDFLARE_ENV=production wrangler deploy",
		"deploy:staging": "CLOUDFLARE_ENV=staging pnpm build && CLOUDFLARE_ENV=staging wrangler deploy",
		"dev": "react-router dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"postinstall": "pnpm cf:typegen",
		"lint": "react-router typegen && eslint .",
		"preview": "pnpm build && vite preview",
		"test": "vitest run",
		"test:a11y": "playwright test e2e/accessibility.spec.ts e2e/accessibility-authenticated.spec.ts",
		"test:e2e": "playwright test",
		"test:watch": "vitest",
		"typecheck": "pnpm cf:typegen && react-router typegen && tsc -b"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.2",
		"isbot": "^5.2.1",
		"lucide-react": "^1.28.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.3.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@cloudflare/vite-plugin": "^1.50.0",
		"@cloudflare/vitest-pool-workers": "^0.20.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@react-router/dev": "^8.3.0",
		"@types/node": "^22.20.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.0.0",
		"prettier": "^3.9.6",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-packagejson": "^3.0.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.2.0",
		"vitest": "^4.1.10",
		"wrangler": "^4.118.0"
	},
	"packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
	"engines": {
		"node": ">=22.22.0"
	}
}
